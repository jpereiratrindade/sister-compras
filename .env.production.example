# Este arquivo deve ser copiado para /etc/sister/sister-compras.env e protegido (chmod 600)
# Ele define as variáveis de ambiente necessárias para o serviço systemd do Compras

# Variáveis do banco de dados do Compras
COMPRAS_DB_USER=sister
COMPRAS_DB_NAME=sister_compras
COMPRAS_DB_PASSWORD=sua_senha_segura_aqui
COMPRAS_DB_PORT=55440

# Configurações do container DB
COMPRAS_DB_CONTAINER=sister-compras-db
COMPRAS_DB_VOLUME=sister_compras_pgdata

# Configuração da Porta do Servidor Web (o Nexo espera o Compras na 8016)
COMPRAS_APP_PORT=8016
NEXO_COMPRAS_HOST=127.0.0.1
